# =============================================================================
# ORTAM
# =============================================================================
ENVIRONMENT=development          # development | testing | production

# =============================================================================
# SUNUCU
# =============================================================================
PROXY_HOST=0.0.0.0
PROXY_PORT=8765
PROXY_WORKERS=1
PROXY_DOCS_ENABLED=true          # Üretimde false

# =============================================================================
# TLS
# =============================================================================
PROXY_TLS_ENABLED=false
PROXY_TLS_CERT=certs/server.crt  # python main.py --gen-cert ile oluştur
PROXY_TLS_KEY=certs/server.key
PROXY_TLS_CA=                    # mTLS için CA (opsiyonel)
PROXY_MTLS_ENABLED=false

# =============================================================================
# JWT
# =============================================================================
JWT_SECRET=                      # ZORUNLU — min 32 karakter rastgele string
                                 # Üret: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_PREVIOUS=             # Rotation sırasında eski key (opsiyonel)
JWT_EXPIRY_HOURS=1
JWT_REFRESH_EXPIRY_DAYS=7
JWT_ALGORITHM=HS256
JWT_BIND_IP=true                 # Token'ı IP'ye bağla (false=mobil kullanıcılar için)
JWT_MAX_SESSIONS=3               # Kullanıcı başına max aktif token

# =============================================================================
# LDAP (opsiyonel)
# =============================================================================
LDAP_ENABLED=false
LDAP_SERVER=ldap://dc.example.com:389
LDAP_BASE_DN=DC=example,DC=com
LDAP_BIND_DN=CN=svc-llmsentinel,OU=ServiceAccounts,DC=example,DC=com
LDAP_BIND_PASSWORD=
LDAP_USER_FILTER=(sAMAccountName={username})
LDAP_GROUP_FILTER=(member={dn})
LDAP_ADMIN_GROUP=CN=LLM-Sentinel-Admins,OU=Groups,DC=example,DC=com
LDAP_OPERATOR_GROUP=CN=LLM-Sentinel-Operators,OU=Groups,DC=example,DC=com
LDAP_USE_SSL=false
LDAP_VERIFY_CERT=true
LDAP_CACHE_TTL_SECONDS=300

# =============================================================================
# AI PROVIDER API KEY'LERİ
# !! BU ALANLARA KEY YAZILMAZ — Admin UI'dan girilir !!
# Aşağıdakiler YALNIZCA ilk kurulumda DB boşsa seed için kullanılır.
# Boş bırakmak güvenli ve önerilen yöntemdir.
# =============================================================================
ANTHROPIC_API_KEYS=
OPENAI_API_KEYS=
AZURE_OPENAI_API_KEYS=
AZURE_OPENAI_ENDPOINT=               # Örnek: https://mycompany.openai.azure.com
AZURE_OPENAI_API_VERSION=2024-02-01
GEMINI_API_KEYS=
GROQ_API_KEYS=
MISTRAL_API_KEYS=
OLLAMA_BASE_URLS=
# AWS Bedrock: AWS_ACCESS_KEY_ID + AWS_SECRET_ACCESS_KEY env'den okunur (standart boto3)
AWS_BEDROCK_REGION=us-east-1
# Özel OpenAI-uyumlu endpoint'ler Admin UI → Providers sekmesinden eklenir

# =============================================================================
# KEY POOL
# =============================================================================
KEY_ROTATION_STRATEGY=round_robin    # round_robin | random | least_used
KEY_ENCRYPTION_SECRET=               # ZORUNLU (production veya WORKERS>1)
                                     # Üret: python -c "import secrets; print(secrets.token_hex(32))"
KEY_ENCRYPTION_SECRET_PREVIOUS=      # Rotation sırasında eski key (opsiyonel)

# =============================================================================
# RATE LİMİTİNG — İSTEK/DAKİKA (RPM)
# =============================================================================
GLOBAL_RATE_LIMIT_RPM=1000
IP_RATE_LIMIT_RPM=60
IP_BAN_THRESHOLD=10
IP_BAN_DURATION_SECONDS=900

# =============================================================================
# RATE LİMİTİNG — TOKEN/DAKİKA (TPM)
# =============================================================================
GLOBAL_RATE_LIMIT_TPM=500000
CLIENT_DEFAULT_TPM=50000

# =============================================================================
# İSTEK LİMİTLERİ
# =============================================================================
MAX_REQUEST_BODY_KB=512
MAX_MESSAGES_PER_REQUEST=50
MAX_TOKENS_PER_REQUEST=100000
MAX_CONCURRENT_GLOBAL=100

# =============================================================================
# CONTEXT WINDOW KORUMASI
# =============================================================================
MAX_CONTEXT_TOKENS_DEFAULT=128000
CONTEXT_TRUNCATION_ENABLED=true

# =============================================================================
# CIRCUIT BREAKER
# =============================================================================
CB_FAILURE_THRESHOLD=5
CB_RECOVERY_TIMEOUT_SECONDS=60

# =============================================================================
# RETRY
# =============================================================================
MAX_RETRIES=3

# =============================================================================
# PROVIDER ZAMAN AŞIMLARI (saniye)
# =============================================================================
ANTHROPIC_TIMEOUT_SECONDS=120
OPENAI_TIMEOUT_SECONDS=120
GEMINI_TIMEOUT_SECONDS=120
OLLAMA_TIMEOUT_SECONDS=300

# =============================================================================
# FALLBACK ZİNCİRİ
# =============================================================================
FALLBACK_CHAIN=anthropic            # Virgülle ayrılmış provider listesi

# =============================================================================
# REDİS (opsiyonel)
# Boşsa in-memory fallback. Çoklu worker için zorunlu.
# =============================================================================
REDIS_URL=
# Örnek: REDIS_URL=redis://localhost:6379/0

# =============================================================================
# VERİTABANI
# =============================================================================
DATABASE_URL=sqlite+aiosqlite:///./data/proxy.db
# PostgreSQL: DATABASE_URL=postgresql+psycopg://user:pass@localhost:5432/llmsentinel

# =============================================================================
# STREAMİNG
# =============================================================================
STREAMING_ENABLED=true

# =============================================================================
# LOGLAMA
# =============================================================================
PROXY_LOG_LEVEL=INFO                 # DEBUG | INFO | WARNING | ERROR
PROXY_LOG_FILE=data/proxy.log
LOG_FORMAT=text                      # text (development) | json (production)
RETENTION_DAYS=90

# =============================================================================
# İSTEK/CEVAP LOGLAMA (opsiyonel, performans etkisi var)
# =============================================================================
LOG_REQUEST_BODY=false
LOG_REQUEST_MAX_BODY_CHARS=500

# =============================================================================
# ADMİN
# =============================================================================
ADMIN_SESSION_TIMEOUT_MINUTES=60
METRICS_TOKEN=                       # GET /v1/metrics için token; boşsa endpoint kapalı

# =============================================================================
# GÜVENLİK
# =============================================================================
CORS_ALLOWED_ORIGINS=http://localhost:3000    # Virgülle ayrılmış
AUDIT_DEPS=false                             # Başlangıçta pip-audit çalıştır
PASSWORD_MIN_LENGTH=12                       # Local user şifre minimum uzunluk
REQUIRE_REQUEST_SIGNING=false                # İstek imzalama (replay protection)
REQUEST_SIGNING_MAX_AGE_SECONDS=300          # İmzalı isteğin max yaşı

# =============================================================================
# SECRET PROVIDER (opsiyonel)
# Vault entegrasyonu için. Yoksa .env'den düz metin okunur.
# =============================================================================
VAULT_ADDR=                                  # Örnek: https://vault.example.com:8200
VAULT_TOKEN=                                 # Vault auth token

# =============================================================================
# WEBHOOK ALERTLER
# =============================================================================
WEBHOOK_SECRET=                      # HMAC-SHA256 imzalama anahtarı (opsiyonel)

# =============================================================================
# OTOMATİK YEDEKLEME
# =============================================================================
BACKUP_ENABLED=false
BACKUP_DIR=data/backups
BACKUP_KEEP_DAYS=7

# =============================================================================
# SEMANTIC CACHE
# =============================================================================
CACHE_ENABLED=true
CACHE_TTL_SECONDS=3600               # Cache süresi (1 saat)
CACHE_MAX_TOKENS=1000                # Bu token'dan büyük yanıtlar cache'lenmez
CACHE_STRATEGY=exact                 # exact | semantic

# =============================================================================
# PRIORITY QUEUING
# =============================================================================
QUEUE_TIMEOUT_SECONDS=30             # Kuyrukta max bekleme süresi
